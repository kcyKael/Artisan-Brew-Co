APP_NAME="Artisan Brew Co."
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=UTC
POS_DISPLAY_TIMEZONE=Asia/Manila

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=artisan_brew_co
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@artisanbrewco.local"
MAIL_FROM_NAME="${APP_NAME}"

BREVO_API_KEY=
BREVO_API_BASE_URL=https://api.brevo.com/v3
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME="Artisan Brew Co."
BREVO_REPLY_TO_EMAIL=
BREVO_WEBHOOK_TOKEN=
BREVO_MARKETING_LIST_ID=
BREVO_LIVE_SEND_ENABLED=false
BREVO_HTTP_TIMEOUT=15
BREVO_HTTP_CONNECT_TIMEOUT=5
BREVO_MAX_RETRIES=4

ABC_OWNER_ALERT_EMAILS=
ABC_CAFE_INBOX_EMAIL=
ABC_DAILY_SUMMARY_TIME=22:00
ABC_STOCK_ALERT_MODE=immediate

VITE_APP_NAME="${APP_NAME}"
